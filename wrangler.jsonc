{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "releasebar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  // Deploys keep the plain-text variables set on the Worker in the dashboard, such as GITHUB_APP_SLUG.
  // Without this, each deploy deletes every variable this configuration does not list.
  "keep_vars": true,
  "upload_source_maps": true,

  // This file holds no deployment of its own: no custom domain, admin logins or resource IDs.
  // `npm run deploy` builds with Vite, which adds them from RELEASEBAR_* environment variables
  // (see docs/self-hosting.md) to the config it writes for the deploy: dist/releasebar/wrangler.json.

  "vars": {
    "ANTHROPIC_SUMMARY_MODEL": "claude-haiku-5-5",
  },

  "triggers": {
    "crons": ["*/15 * * * *"],
  },

  // Needed by the Wrangler commands that read this file instead of the built config: the dry run
  // of .github/workflows/cloudflare.yml (`wrangler deploy --dry-run` on a fresh checkout) and
  // `npm run dev:worker:real`. They bundle `main` themselves and need the app built first, for
  // `assets.directory`. The Cloudflare Vite plugin has no use for it and says so in a warning on
  // every `vite build`; it is the only option that warning names.
  "build": {
    "command": "npm run build",
  },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true,
  },

  "kv_namespaces": [{ "binding": "DASHBOARD_CACHE" }],

  // No database ID here: a deployment sets RELEASEBAR_D1_DATABASE_ID, and `npm run deploy` refuses
  // without it. Wrangler would otherwise create the database itself on deploy, outside any
  // jurisdiction, and a jurisdiction can't be added to a database later. `npm run deploy` applies
  // the SQL files of `migrations/` to the database before it deploys the Worker.
  "d1_databases": [
    { "binding": "DB", "database_name": "releasebar", "migrations_dir": "migrations" },
  ],

  "queues": {
    "producers": [{ "binding": "REFRESH_QUEUE", "queue": "releasebar-refresh" }],
    "consumers": [
      {
        "queue": "releasebar-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "releasebar-refresh-dlq",
        "max_concurrency": 5,
      },
    ],
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Strips query strings from request URLs in logs and traces, such as the GitHub OAuth `code`
    // and `state` on /api/auth/callback.
    "redact_query_string": true,

    // Invocation logs carry each request's headers and Cloudflare metadata, including the client IP
    // and location. Keep only the Worker's own logs, exceptions and errors, which Issues needs.
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },

    // Groups exceptions and failed invocations into Issues.
    "issues": {
      "enabled": true,
    },

    // Traces of one invocation in twenty: enough to see where a request, a tick or a queue job
    // spends its time (KV, D1, the objects, GitHub) without a span for every call of every
    // invocation. Query strings are redacted in traces as in logs.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },

  // One class per kind of object; worker/runtime.ts names the instances. Every binding is listed
  // in `durableObjectBindings` of worker/store/bindings.ts, which scopes them to
  // RELEASEBAR_DO_JURISDICTION.
  "durable_objects": {
    "bindings": [
      { "name": "BUILD_COORDINATOR", "class_name": "BuildCoordinator" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "SUMMARY_QUOTA", "class_name": "SummaryQuota" },
      { "name": "WEBHOOK_ADMISSION", "class_name": "WebhookAdmission" },
      { "name": "WEBHOOK_PROCESSOR", "class_name": "WebhookProcessor" },
    ],
  },

  // A migration is applied once and never edited afterwards: a change to the classes is a new
  // entry with a new tag, at the end. The tags and the deleted classes are history: Cloudflare
  // has applied them to the deployed Worker, so they stay as they are.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DashboardBuildLock"] },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "BuildCoordinator",
        "OwnerMetadata",
        "RefreshTargetIndex",
        "SummaryQuota",
        "WebhookAdmission",
        "WebhookProcessor",
      ],
      "deleted_classes": ["DashboardBuildLock"],
    },
    // The index of refresh targets is a D1 table: migrations/0001_refresh.sql.
    { "tag": "7a-refresh", "deleted_classes": ["RefreshTargetIndex"] },
    { "tag": "7b-rate-limits", "new_sqlite_classes": ["RateLimiter"] },
    // Owner metadata is a D1 table: migrations/0003_registry.sql.
    { "tag": "7c-registry", "deleted_classes": ["OwnerMetadata"] },
  ],
}
