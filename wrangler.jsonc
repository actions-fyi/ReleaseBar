{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "releasebar",
  "main": "node_modules/.cache/releasebar-build/worker/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  // Deploys keep the plain-text variables set on the Worker in the dashboard, such as GITHUB_APP_SLUG.
  // Without this, each deploy deletes every variable this configuration does not list.
  "keep_vars": true,
  "upload_source_maps": true,

  // This file holds no deployment of its own: no custom domain, admin logins or resource IDs.
  // `npm run deploy` adds them from RELEASEBAR_* environment variables (see docs/self-hosting.md)
  // and deploys from the generated wrangler.deploy.json.

  "vars": {
    "ANTHROPIC_SUMMARY_MODEL": "claude-haiku-5-5",
  },

  "triggers": {
    "crons": ["*/15 * * * *"],
  },

  "build": {
    "command": "npm run build",
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true,
  },

  "kv_namespaces": [{ "binding": "DASHBOARD_CACHE" }],

  "queues": {
    "producers": [{ "binding": "REFRESH_QUEUE", "queue": "releasebar-refresh" }],
    "consumers": [
      {
        "queue": "releasebar-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 10,
        "dead_letter_queue": "releasebar-refresh-dlq",
        "max_concurrency": 5,
      },
    ],
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Strips query strings from request URLs in logs and traces, such as the GitHub OAuth `code`
    // and `state` on /api/auth/callback.
    "redact_query_string": true,

    // Invocation logs carry each request's headers and Cloudflare metadata, including the client IP
    // and location. Keep only the Worker's own logs, exceptions and errors, which Issues needs.
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },

    // Groups exceptions and failed invocations into Issues. Traces stay off; enable them
    // (`observability.traces`) only while investigating something.
    "issues": {
      "enabled": true,
    },
  },

  "durable_objects": {
    "bindings": [{ "name": "DASHBOARD_LOCKS", "class_name": "DashboardBuildLock" }],
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DashboardBuildLock"] }],
}
