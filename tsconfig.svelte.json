{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "types": ["node", "svelte", "vite/client"]
  },
  "include": [
    "src/**/*.svelte",
    "src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "svelte.config.js"
  ]
}
