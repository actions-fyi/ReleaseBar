{
  "name": "releasebar",
  "version": "0.2.6",
  "private": true,
  "description": "Release freshness dashboard for open source maintainers.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:data": "vite build && node scripts/build.ts",
    "check": "npm run check:static && npm run check:data",
    "check:data": "node scripts/build.ts --check",
    "check:size": "node scripts/check-file-size.mjs",
    "check:store": "node scripts/check-store-boundary.ts",
    "check:static": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test",
    "deploy": "node scripts/deploy-settings.ts && vite build && npm run deploy:migrations && wrangler deploy",
    "deploy:migrations": "wrangler d1 migrations apply DB --remote --config dist/releasebar/wrangler.json",
    "deploy:preview": "node scripts/deploy-settings.ts && vite build && wrangler versions upload",
    "dev": "vite dev --host 127.0.0.1",
    "dev:worker:real": "wrangler dev --config wrangler.jsonc --remote --port 8787",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "npm run check:size && npm run check:store && oxlint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "npm run types:check && tsc --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json",
    "types": "wrangler types --config wrangler.jsonc --strict-vars=false",
    "types:check": "wrangler types --config wrangler.jsonc --strict-vars=false --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bits-ui": "^2.21.0",
    "svelte": "^5.57.3",
    "svelte-command-palette": "^2.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.2",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.94.0",
    "svelte-check": "4.7.8",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
