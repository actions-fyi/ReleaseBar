{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "test/**/*.ts",
    "worker/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
